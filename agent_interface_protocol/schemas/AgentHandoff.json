{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable handoff between agents (v4 flat shape). Semantic, policy, and addressing fields live at the top level \u2014 no nested semantic_context or execution_policy sub-objects.",
  "properties": {
    "action": {
      "type": "string"
    },
    "agent_interface_version": {
      "description": "Protocol version. This build accepts versions in [4, 4]; widening the range will be reflected in updated schemas.",
      "maximum": 4,
      "minimum": 4,
      "type": "integer"
    },
    "args": {
      "type": "object"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "context_extra": {
      "type": "object"
    },
    "decisions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "dependency_keys": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "expected_outcome": {
      "type": "string"
    },
    "handoff_id": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "max_steps": {
      "type": "integer"
    },
    "observations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "policy_extra": {
      "type": "object"
    },
    "priority": {
      "type": "integer"
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "source_agent": {
      "type": "string"
    },
    "source_summary": {
      "type": "string"
    },
    "target_agent": {
      "type": "string"
    },
    "user_goal": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "write_scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "AgentHandoff",
  "type": "object"
}
