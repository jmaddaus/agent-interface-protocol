            "state": {
              "type": "object"
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "checkpoint"
        }
      }
    },
    {
      "properties": {
        "body": {
          "additionalProperties": false,
          "properties": {
            "details": {
              "type": "object"
            },
            "findings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "passed": {
              "type": "boolean"
            },
            "score": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "evaluation"
        }
      }
    }
  ],
  "description": "One event in the timeline of a single agent step.",
  "properties": {
    "body": {
      "type": "object"
    },
    "handoff_id": {
      "type": "string"
    },
    "harness_policy": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "type": "object"
        },
        "contract_id": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        },
        "max_steps": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tool_calls": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "required_outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requires_self_evaluation": {
          "type": "boolean"
        }
