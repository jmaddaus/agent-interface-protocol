            }
          },
          "type": "object"
        },
        "kind": {
          "const": "question"
        }
      }
    },
    {
      "properties": {
        "body": {
          "additionalProperties": false,
          "properties": {
            "action_summary": {
              "type": "string"
            },
            "agent_interface_version": {
              "description": "Protocol version. This build accepts versions in [4, 4]; widening the range will be reflected in updated schemas.",
              "maximum": 4,
              "minimum": 4,
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "followups": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "next_handoff_id": {
              "type": "string"
            },
            "observations": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "question": {
              "type": "string"
            },
            "result_extra": {
              "type": "object"
            },
            "state_changes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "status": {
              "enum": [
                "awaiting_input",
                "completed",
                "failed",
                "noop",
                "retry_scheduled"
              ],
              "type": "string"
            },
            "telemetry": {
              "type": "object"
            },
            "tool_events": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "args": {
                    "type": "object"
                  },
                  "error": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "ui_preview": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "unresolved_questions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "user_visible_response": {
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        "kind": {
          "const": "final"
        }
      }
    },
    {
      "properties": {
        "body": {
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": "string"
