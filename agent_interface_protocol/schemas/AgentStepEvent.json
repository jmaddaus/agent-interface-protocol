      "type": [
        "object",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "accepted",
        "checkpoint",
        "evaluation",
        "final",
        "partial_response",
        "phase_completed",
        "phase_started",
        "progress",
        "question",
        "tool_event"
      ],
      "type": "string"
    },
    "orchestration": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string"
        },
        "checkpoint_id": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        },
        "fanout_group_id": {
          "type": "string"
        },
        "parent_step_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "root_handoff_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "step_id": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "title": "AgentStepEvent",
  "type": "object"
}
