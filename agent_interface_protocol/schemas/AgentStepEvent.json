            "message": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "progress"
        }
      }
    },
    {
      "properties": {
        "body": {
          "additionalProperties": false,
          "properties": {
            "args": {
              "type": "object"
            },
            "error": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "ui_preview": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "tool_event"
        }
      }
    },
    {
      "properties": {
        "body": {
          "additionalProperties": false,
