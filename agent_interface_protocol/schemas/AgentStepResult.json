{
  "$defs": {
    "AgentHandoff": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "agent_interface_version": {
          "description": "Protocol version. This build accepts versions in [1, 3]; widening the range will be reflected in updated schemas.",
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "args": {
          "type": "object"
        },
        "execution_policy": {
          "$ref": "#/$defs/ExecutionPolicy"
        },
        "handoff_id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "semantic_context": {
          "$ref": "#/$defs/SemanticContext"
        },
        "source_agent": {
          "type": "string"
        },
        "target_agent": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "dependency_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extra": {
          "type": "object"
        },
        "max_steps": {
          "type": "integer"
        },
        "priority": {
          "type": "integer"
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "write_scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SemanticContext": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_outcome": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_summary": {
          "type": "string"
        },
        "user_goal": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "SemanticResult": {
      "additionalProperties": false,
      "properties": {
        "action_summary": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        },
        "followups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state_changes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unresolved_questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ToolEvent": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": "object"
        },
        "error": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ui_preview": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable result of one target-agent step.",
  "properties": {
    "agent_interface_version": {
      "description": "Protocol version. This build accepts versions in [1, 3]; widening the range will be reflected in updated schemas.",
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "error": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "semantic_result": {
      "$ref": "#/$defs/SemanticResult"
    },
    "status": {
      "enum": [
        "awaiting_input",
        "completed",
        "failed",
        "noop",
        "retry_scheduled"
      ],
      "type": "string"
    },
    "telemetry": {
      "type": "object"
    },
    "tool_events": {
      "items": {
        "$ref": "#/$defs/ToolEvent"
      },
      "type": "array"
    },
    "updated_handoff": {
      "oneOf": [
        {
          "$ref": "#/$defs/AgentHandoff"
        },
        {
          "type": "null"
        }
      ]
    },
    "user_visible_response": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "AgentStepResult",
  "type": "object"
}
